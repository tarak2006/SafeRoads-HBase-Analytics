# ==============================================================================
# SafeRoads: Review 2 Demo Script - MEMBER 1
# Role: Schema Architecture, Table Creation & Ingestion
# Items: 2 Filters + 1 Application Query (Total: 3 items)
# ==============================================================================

# --- STEP 1: Create Table with 4 Column Families ---
disable 'saferoads_accidents' rescue nil
drop 'saferoads_accidents' rescue nil
create 'saferoads_accidents', 'loc', 'time', 'env', 'hazard'
exists 'saferoads_accidents'

# --- STEP 2: Ingest Sample Incident Records ---
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'loc:state', 'OH'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'loc:city', 'Reynoldsburg'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'loc:county', 'Franklin'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'loc:lat', '39.93'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'loc:lng', '-82.83'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'time:start_time', '2016-02-08 06:07:59'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'time:duration_min', '30.0'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'time:hour', '6'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'env:weather', 'Light Rain'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'env:temp_f', '37.9'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'hazard:severity', '2'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'hazard:junction', '0'
put 'saferoads_accidents', 'OH#2#2016-02-08#A-2', 'hazard:traffic_signal', '0'

put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'loc:state', 'OH'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'loc:city', 'Dayton'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'loc:county', 'Montgomery'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'time:start_time', '2016-02-08 07:23:34'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'time:duration_min', '30.0'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'time:hour', '7'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'env:weather', 'Mostly Cloudy'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'hazard:severity', '3'
put 'saferoads_accidents', 'OH#3#2016-02-08#A-4', 'hazard:junction', '0'

put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'loc:state', 'OH'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'loc:city', 'Westerville'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'loc:county', 'Franklin'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'time:start_time', '2016-02-09 08:34:21'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'time:duration_min', '30.0'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'time:hour', '8'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'env:weather', 'Light Snow'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'hazard:severity', '2'
put 'saferoads_accidents', 'OH#2#2016-02-09#A-27', 'hazard:junction', '1'

put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'loc:state', 'CA'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'loc:city', 'San Jose'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'loc:county', 'Santa Clara'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'loc:lat', '37.33'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'loc:lng', '-121.89'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'time:start_time', '2016-03-22 14:15:00'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'time:duration_min', '75.0'
put 'saferoads_accidents', 'CA#4#2016-03-22#A-500', 'time:hour', '14'
