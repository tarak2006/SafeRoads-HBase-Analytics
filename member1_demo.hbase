put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'loc:state', 'FL'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'loc:city', 'Miami'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'loc:county', 'Miami-Dade'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'time:start_time', '2016-04-10 14:10:00'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'time:duration_min', '80.0'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'time:hour', '14'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'env:weather', 'Scattered Clouds'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'hazard:severity', '3'
put 'saferoads_accidents', 'FL#3#2016-04-10#A-900', 'hazard:traffic_signal', '1'

# --- STEP 3: FILTER 1 - PrefixFilter ('OH#') ---
# Real-World Scenario: Slicing all Ohio state accidents via row-key index prefix
scan 'saferoads_accidents', {FILTER => "PrefixFilter('OH#')", LIMIT => 5}

# --- STEP 4: FILTER 2 - SingleColumnValueFilter Substring ('Rain') ---
# Real-World Scenario: Identify all accidents under rainy road conditions
scan 'saferoads_accidents', {FILTER => "SingleColumnValueFilter('env', 'weather', =, 'substring:Rain')", LIMIT => 5}

# --- STEP 5: APPLICATION QUERY 1 - EMS Incident Dossier Retrieval ---
# Real-World Scenario: Emergency responders pull full crash profile for crash A-2
get 'saferoads_accidents', 'OH#2#2016-02-08#A-2'

exit
