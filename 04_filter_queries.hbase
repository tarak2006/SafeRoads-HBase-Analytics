# ==============================================================================
# SafeRoads: Big Data Analytics Project Review 2 - Step 4: HBase Filters
# Course: 23CSE352 - Big Data Analytics | Evaluation Rubric: Filters (4 Marks)
# Table Name: saferoads_accidents
# Demonstrates:
#   - Exactly 6 distinct HBase filters answering transportation safety questions
#   - PrefixFilter, SingleColumnValueFilter, and compound FilterList
#   - Multiple comparison operators (=, >=, SubstringComparator, BinaryComparator)
#   - Compound Boolean logic (MUST_PASS_ALL / AND)
#
# NOTE: Ensure records are inserted first before running this script:
#       hbase shell 02_insert_records.hbase
# ==============================================================================


# ------------------------------------------------------------------------------
# FILTER 1: PrefixFilter (Row-Key Prefix Filtering)
# Filter Class: org.apache.hadoop.hbase.filter.PrefixFilter
# Real-World Scenario: State Highway Department Slicing (Ohio State Accidents)
# Logic: Slices all rows starting with prefix 'OH#' using row-key index without full table scans.
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {FILTER => "PrefixFilter('OH#')", LIMIT => 5}


# ------------------------------------------------------------------------------
# FILTER 2: SingleColumnValueFilter with SubstringComparator (Adverse Weather)
# Filter Class: org.apache.hadoop.hbase.filter.SingleColumnValueFilter
# Comparator: SubstringComparator
# Comparison Operator: =
# Real-World Scenario: Identify all accidents occurring in rainy / wet weather conditions
# Logic: Matches any record where env:weather contains 'Rain' (e.g. Light Rain, Rain, Heavy Rain).
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {FILTER => "SingleColumnValueFilter('env', 'weather', =, 'substring:Rain')", LIMIT => 5}


# ------------------------------------------------------------------------------
# FILTER 3: SingleColumnValueFilter with BinaryComparator (Interchange Junctions)
# Filter Class: org.apache.hadoop.hbase.filter.SingleColumnValueFilter
# Comparator: BinaryComparator
# Comparison Operator: =
# Real-World Scenario: Highway Interchange Hazard Analysis
# Logic: Filters crashes occurring at highway merge zones / junctions (hazard:junction = '1').
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {FILTER => "SingleColumnValueFilter('hazard', 'junction', =, 'binary:1')", LIMIT => 5}


# ------------------------------------------------------------------------------
# FILTER 4: SingleColumnValueFilter with BinaryComparator (Traffic Signal Collisions)
# Filter Class: org.apache.hadoop.hbase.filter.SingleColumnValueFilter
# Comparator: BinaryComparator
# Comparison Operator: =
# Real-World Scenario: Urban Signalized Intersection Collision Audit
# Logic: Filters crashes occurring at signalized intersections (hazard:traffic_signal = '1').
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {FILTER => "SingleColumnValueFilter('hazard', 'traffic_signal', =, 'binary:1')", LIMIT => 5}


# ------------------------------------------------------------------------------
# FILTER 5: SingleColumnValueFilter with Greater-Than-or-Equal (Prolonged Stoppage)
# Filter Class: org.apache.hadoop.hbase.filter.SingleColumnValueFilter
# Comparator: BinaryComparator
# Comparison Operator: >=
# Real-World Scenario: Major Roadway Blockages (> 60 minutes)
# Logic: Filters traffic incidents with duration >= 60.0 minutes causing transit gridlock.
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {COLUMNS => ['loc:city', 'loc:state', 'time:duration_min', 'hazard:severity'], FILTER => "SingleColumnValueFilter('time', 'duration_min', >=, 'binary:60.0')", LIMIT => 5}


# ------------------------------------------------------------------------------
# FILTER 6: Compound FilterList with MUST_PASS_ALL (Boolean AND Logic)
# Filter Class: org.apache.hadoop.hbase.filter.FilterList
# Operator: MUST_PASS_ALL (AND)
# Real-World Scenario: High Severity Accidents at Highway Interchanges
# Logic: Combines Severity >= 3 AND Junction = 1 to isolate high-speed interchange collisions.
# ------------------------------------------------------------------------------
scan 'saferoads_accidents', {FILTER => "(SingleColumnValueFilter('hazard', 'severity', >=, 'binary:3') AND SingleColumnValueFilter('hazard', 'junction', =, 'binary:1'))", LIMIT => 5}

exit
